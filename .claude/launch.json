{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mockups",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4173",
        "-d",
        "docs"
      ],
      "port": 4173
    },
    {
      "name": "app-web",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "app/node_modules/expo/bin/cli",
        "start",
        "app",
        "--web",
        "--port",
        "8083"
      ],
      "port": 8083
    },
    {
      "name": "site",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4174",
        "-d",
        "site/public"
      ],
      "port": 4174
    },
    {
      "name": "pay-page-preview",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "4175", "-d", "submission/preview"],
      "port": 4175
    },
    {
      "name": "web",
      "runtimeExecutable": "bunx",
      "runtimeArgs": ["wrangler", "dev", "-c", "web/wrangler.jsonc", "--port", "8790"],
      "port": 8790
    }
  ]
}