// Merge into gateway/wrangler.jsonc (paths are relative to that file). Run prover/sync.sh before `wrangler deploy`: it
// copies the zkeys the image bakes in. The gateway already uses `migrations`, so the class is added as migration v3
// (Cloudflare's docs now show `exports` instead; the two can't be combined).
{
  "containers": [
    {
      "class_name": "ProverContainer",
      "image": "../prover/Dockerfile",
      "image_build_context": "../prover",
      "max_instances": 1,
      "instance_type": { "vcpu": 1, "memory_mib": 3072, "disk_mb": 2000 }
    }
  ],
  "durable_objects": {
    "bindings": [
      // ...the existing SPONSOR and RELAY bindings, then:
      { "name": "PROVER", "class_name": "ProverContainer" }
    ]
  },
  "migrations": [
    // ...the existing v1 (Sponsor) and v2 (Relay), then:
    { "tag": "v3", "new_sqlite_classes": ["ProverContainer"] }
  ]
}
