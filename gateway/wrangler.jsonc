{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "ender-money-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "vars": {
    "FEE_AUSD": "0.001"
  },

  "d1_databases": [
    { "binding": "DB", "database_name": "ender-money", "database_id": "local-only", "migrations_dir": "migrations" }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "SPONSOR", "class_name": "Sponsor" },
      { "name": "RELAY", "class_name": "Relay" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Sponsor"] },
    { "tag": "v2", "new_sqlite_classes": ["Relay"] }
  ]
}
