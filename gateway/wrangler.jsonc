{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "ender-money-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "routes": [
    { "pattern": "api.ender.money", "custom_domain": true },
    // Ender ID pay pages, https://<label>.ender.my. Needs a proxied wildcard DNS record on ender.my (docs/gateway.md
    // "Ender IDs"); the route can belong to one Worker only, so ender-backend's must go first.
    { "pattern": "*.ender.my/*", "zone_name": "ender.my" }
  ],

  // A runaway request dies here; proving runs in the container, so nothing legitimate needs more.
  "limits": { "cpu_ms": 5000 },

  "vars": {
    // Emergency stop: "1" answers every request with 503 and skips the cron.
    "PAUSED": "0",
    "FEE_AUSD": "0.01",
    "SMS_RETRIEVER_HASH": "IaTP8lLJOvM",
    // Where Alchemy's Address Activity webhooks deliver. Webhooks are made only once the ALCHEMY_AUTH_TOKEN secret is set.
    "ALCHEMY_WEBHOOK_URL": "https://api.ender.money/webhooks/alchemy",
    // EnderResolver on Ethereum mainnet (ender-backend/contracts, deployed by 0x3f87…a2d3): /ccip signs for it. The
    // signing key is the RESOLVER_SIGNER_KEY secret; without it /ccip answers 503.
    "RESOLVER_ADDRESS": "0xf0b537E1FDa87349d43E3aF991150aa6a0dCe01B",
    // Auto-bridge (docs/gateway.md "Auto-bridge"): the Relay app fee pays our gas × markup + flat USD; a balance under
    // the minimum, or whose fee would pass the cap, waits. BRIDGE_FEE_RECIPIENT is unset: the gateway key's address,
    // which the app ships. JSON-RPC there is Alchemy's with the ALCHEMY_API_KEY secret, public endpoints behind it.
    "BRIDGE_GAS_MARKUP": "1.3",
    "BRIDGE_FEE_FLAT_USD": "0",
    "BRIDGE_MAX_FEE_PCT": "5",
    "BRIDGE_MIN_USD": "1",
    // Changing an Ender ID without a verified phone: this much AUSD, paid on Monad mainnet to TREASURY_ADDRESS (unset:
    // the gateway key's address, which GET /account/name tells the app).
    "NAME_FEE_AUSD": "2"
  },

  "ratelimits": [{ "name": "IP_LIMITER", "namespace_id": "4101", "simple": { "limit": 30, "period": 60 } }],

  // Every minute: reconcile stuck sessions, push newly linked addresses to Alchemy (creating each network's first webhook).
  "triggers": { "crons": ["* * * * *"] },

  "d1_databases": [
    { "binding": "DB", "database_name": "ender-money", "database_id": "a708e05c-85c9-4fd4-ac91-01c36414f59f", "migrations_dir": "migrations" }
  ],

  // Groth16 prover for the shielded pool (prover/). Run prover/sync.sh before deploying: it copies the zkeys the image
  // bakes in. One instance, asleep 60 s after its last request.
  "containers": [
    {
      "class_name": "ProverContainer",
      "image": "../prover/Dockerfile",
      "image_build_context": "../prover",
      "max_instances": 1,
      "instance_type": { "vcpu": 1, "memory_mib": 3072, "disk_mb": 2000 }
    }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "SPONSOR", "class_name": "Sponsor" },
      { "name": "RELAY", "class_name": "Relay" },
      { "name": "PROVER", "class_name": "ProverContainer" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Sponsor"] },
    { "tag": "v2", "new_sqlite_classes": ["Relay"] },
    { "tag": "v3", "new_sqlite_classes": ["ProverContainer"] }
  ]
}
