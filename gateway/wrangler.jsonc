{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "ender-money-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "routes": [
    { "pattern": "api.ender.money", "custom_domain": true },
    // Passkey association for the app; the rest of ender.money is not ours to serve.
    { "pattern": "ender.money/.well-known/assetlinks.json", "zone_name": "ender.money" }
  ],

  "vars": {
    "FEE_AUSD": "0.01",
    "SMS_RETRIEVER_HASH": "IaTP8lLJOvM",
    // Where Alchemy's Address Activity webhooks deliver. Webhooks are made only once the ALCHEMY_AUTH_TOKEN secret is set.
    "ALCHEMY_WEBHOOK_URL": "https://api.ender.money/webhooks/alchemy"
  },

  "ratelimits": [{ "name": "IP_LIMITER", "namespace_id": "4101", "simple": { "limit": 30, "period": 60 } }],

  // Every minute: reconcile stuck sessions, push newly linked addresses to Alchemy (creating each network's first webhook).
  "triggers": { "crons": ["* * * * *"] },

  "d1_databases": [
    { "binding": "DB", "database_name": "ender-money", "database_id": "a708e05c-85c9-4fd4-ac91-01c36414f59f", "migrations_dir": "migrations" }
  ],

  // Groth16 prover for the shielded pool (prover/). Run prover/sync.sh before deploying: it copies the zkeys the image
  // bakes in. One instance, asleep 60 s after its last request.
  "containers": [
    {
      "class_name": "ProverContainer",
      "image": "../prover/Dockerfile",
      "image_build_context": "../prover",
      "max_instances": 1,
      "instance_type": { "vcpu": 1, "memory_mib": 3072, "disk_mb": 2000 }
    }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "SPONSOR", "class_name": "Sponsor" },
      { "name": "RELAY", "class_name": "Relay" },
      { "name": "PROVER", "class_name": "ProverContainer" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Sponsor"] },
    { "tag": "v2", "new_sqlite_classes": ["Relay"] },
    { "tag": "v3", "new_sqlite_classes": ["ProverContainer"] }
  ]
}
