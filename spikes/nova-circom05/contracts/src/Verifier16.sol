          vk.IC[21] = Pairing16.G1Point(20530464465863019102122853593186809585441513794539889973865965072453705820318, 14991777008972730911449786662565342342572637469547249148552322415763084812663);
    }

    /*
     * @returns Whether the proof is valid given the hardcoded verifying key
     *          above and the public inputs
     */
    function verifyProof(
        bytes memory proof,
        uint256[21] memory input
    ) public view returns (bool) {
        uint256[8] memory p = abi.decode(proof, (uint256[8]));
        for (uint8 i = 0; i < p.length; i++) {
            // Make sure that each element in the proof is less than the prime q
            require(p[i] < PRIME_Q, "verifier-proof-element-gte-prime-q");
        }
        Pairing16.G1Point memory proofA = Pairing16.G1Point(p[0], p[1]);
        Pairing16.G2Point memory proofB = Pairing16.G2Point([p[2], p[3]], [p[4], p[5]]);
        Pairing16.G1Point memory proofC = Pairing16.G1Point(p[6], p[7]);

        VerifyingKey memory vk = verifyingKey();
        // Compute the linear combination vkX
        Pairing16.G1Point memory vkX = vk.IC[0];
        for (uint256 i = 0; i < input.length; i++) {
            // Make sure that every input is less than the snark scalar field
            require(input[i] < SNARK_SCALAR_FIELD, "verifier-input-gte-snark-scalar-field");
            vkX = Pairing16.plus(vkX, Pairing16.scalarMul(vk.IC[i + 1], input[i]));
        }

        return Pairing16.pairing(
            Pairing16.negate(proofA),
            proofB,
            vk.alfa1,
            vk.beta2,
            vkX,
            vk.gamma2,
            proofC,
            vk.delta2
        );
    }
}

