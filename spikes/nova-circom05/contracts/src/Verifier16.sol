          vk.IC[18] = Pairing16.G1Point(3516856003853403000442245999183198380975959615381845025608112431391461070383, 10711382281520785767671816107701514642102562201464832150236032177386773708032);
          vk.IC[19] = Pairing16.G1Point(15755139060959032737571566161672320944063146697438998308206610456583707764498, 16543594715928191718633296616097483035896368449522398272545105509529717287993);
