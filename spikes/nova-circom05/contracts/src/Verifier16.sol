          vk.IC[9] = Pairing16.G1Point(12595859642870239802594887660772218843905230335110043137109246373964493961608, 71439004344756184272263350374398881206519169027299326686198702237342313214);
          vk.IC[10] = Pairing16.G1Point(524921336630909752154958884075175602751318248591965014631849742546275157484, 110532079817483593870882172609652078812124508495987715691253651883600282377);
