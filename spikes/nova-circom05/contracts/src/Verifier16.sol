          vk.delta2 = Pairing16.G2Point([14623839935633025764960099305745885900725033476410277769574272530774486802992, 7715265879095709765442636154789753990545632407721163114740487405659889450605], [4838088153792416996066151650646110777950252906387243373050168214507542973065, 7393803945770668533054520029130793145726046302788823982952079804367834932939]);
          
          vk.IC[0] = Pairing16.G1Point(8307943996043971862099936807204978700064264112741817597977950953721415433731, 16757840685942024641087043417019690383833544359172504978747480204379050108032);
