{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "viem": [
        "./node_modules/viem"
      ],
      "viem/*": [
        "./node_modules/viem/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../protocol/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "../protocol/**/*.test.ts"
  ]
}