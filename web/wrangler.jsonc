// app.ender.money: the Expo app's web build (testnet only), served as static assets.
// Build with `bun run web:build`, deploy with `bun run web:deploy`.
{
  "name": "ender-app",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "../app/dist-web", "not_found_handling": "single-page-application" },
  "routes": [{ "pattern": "app.ender.money", "custom_domain": true }]
}
